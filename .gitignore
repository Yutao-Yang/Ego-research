# ---------- LaTeX 编译产物 ----------
# 中间文件与 PDF 同放在各级 pdf/ 子目录里：main/pdf/（合并入口）、
# reports/<folder>/pdf/、beamer/<folder>/pdf/ 都适用。
# 下面按扩展名逐类忽略中间文件；PDF 本身保留入库（见下）。

# 中间文件（含 pdf/ 下的 *.synctex.gz；不影响 figures/ 里的图片）
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.ilg
*.ind
*.idx
*.lof
*.log
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.xdv
